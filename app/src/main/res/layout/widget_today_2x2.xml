                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_2"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_bar_2"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@color/widget_primary" />

                <TextView
                    android:id="@+id/widget_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_room_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="47dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_3"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_3"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_bar_3"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@color/widget_primary" />

                <TextView
                    android:id="@+id/widget_name_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_room_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="47dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_4"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_4"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_bar_4"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@color/widget_primary" />

                <TextView
                    android:id="@+id/widget_name_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_room_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="47dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_5"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_5"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_bar_5"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@color/widget_primary" />

                <TextView
                    android:id="@+id/widget_name_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_room_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
