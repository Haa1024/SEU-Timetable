    <!--
      上课提醒。

      reminder_title 的两个参数：课程名、节次（如「数据结构 · 第 3-4 节」）。
      body 里的分钟数用「提前量」而非"此刻距上课还有多久"——通知是在提醒时刻那一刻发的，
      届时距上课正好是提前量。
    -->
    <string name="reminder_channel_name">上课提醒</string>
    <string name="reminder_channel_desc">每节课开始前提醒一次</string>
    <string name="reminder_unknown_course">有课</string>
    <string name="reminder_title">%1$s · %2$s</string>
    <string name="reminder_body">%1$s 开始，还有 %2$d 分钟</string>
    <string name="reminder_body_room">%1$s 开始，还有 %2$d 分钟 · %3$s</string>
    <!-- 测试通知：近两周无课可提醒时也允许用户体验样式，用固定示例内容 -->
    <string name="reminder_sample_title">上课提醒 · 示例</string>
    <string name="reminder_sample_body">数据结构 · 第 3-4 节 14:00 开始，还有 15 分钟</string>

